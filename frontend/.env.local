# 本地开发
# - BACKEND_URL：Next.js rewrites 把 /api/* /ws/* 转到本机后端
# - NEXT_PUBLIC_API_URL 留空：普通 REST 走同域 /api（无 CORS）
# - NEXT_PUBLIC_WS_URL：WebSocket 直连
# - 聊天 SSE 也会用 WS_URL 推导 http 直连后端，避免 Next 缓冲导致「一瞬间出全文」
BACKEND_URL=http://127.0.0.1:8002
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8002

