# ==========================================
# 因子挖掘与交易系统 - 环境变量模板
# ==========================================
# 复制为 .env 后填写真实值,切勿提交 .env 到 git
#
# 容器部署时,基础设施地址会被 docker-compose.yml 的 environment 覆盖。
# 此文件作为本地开发参考 + compose env_file 的来源(backend 必需变量都要存在)。

# ---------- PostgreSQL ----------
# 生产:容器名 postgres:5432(postgres:18 容器,加入 app-net 网络)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=factor_lab
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------- TickData 历史 K线库（pg-tickdata：8亿级全周期历史，2005 起）----------
# 仅用于 K线图历史回溯（懒加载拖动加载）；未配置则自动降级到 HTTP/PG，不影响现网。
# 自备同类 PG 时填写（例：同机容器可填宿主 IP）。
# 密码勿提交，由各环境 .env 注入。
TICKDATA_POSTGRES_HOST=
TICKDATA_POSTGRES_PORT=5434
TICKDATA_POSTGRES_USER=
TICKDATA_POSTGRES_PASSWORD=
TICKDATA_POSTGRES_DB=tickdata

# ---------- Redis ----------
# 容器部署内部使用 redis:6379 服务。
# 以下值供宿主机本地开发通过回环端口访问。
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=0
REDIS_HOST_PORT=6380

# ---------- Qdrant(向量库)----------
# 容器部署用服务名 qdrant（见 docker-compose）；裸机部署填自建实例地址
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ---------- JWT 认证 ----------
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- AES-256-GCM 加密密钥（必填，缺失则加解密直接失败）----------
# 用于 API Key 加密存储；解码后必须为 32 字节。生成方式:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
AES_ENCRYPTION_KEY=change_me_base64_32_bytes

# ---------- GitHub Token(AI Skills 商城集成)----------
GITHUB_TOKEN=

# ---------- 应用配置 ----------
# production:不自动建表(首次部署用 development 建表后切回)
APP_ENV=production
LOG_LEVEL=INFO

# ---------- 实时行情渠道 ----------
MARKET_DATA_CHANNEL_DEFAULT=okx

# ---------- K 线远端兜底源（可选）----------
# 本地所有 K 线源不可用时，从该服务器 /api/market/kline 中转历史。
# 例如另一台已配好数据源的部署：http://192.0.2.10:8002。
KLINE_REMOTE_BASE=
